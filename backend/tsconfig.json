{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "./dist-server",
    "rootDir": "."
  },
  "include": [
    "server.ts",
    "app.ts",
    "config/**/*",
    "controllers/**/*",
    "middlewares/**/*",
    "routes/**/*",
    "services/**/*",
    "utils/**/*",
    "scripts/**/*",
    "types/**/*"
  ]
}
