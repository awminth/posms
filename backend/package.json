{
  "name": "omnipos-backend",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,UI -c cyan,magenta \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "tsx watch server.ts",
    "dev:frontend": "npm run dev --prefix ../frontend",
    "start": "tsx server.ts",
    "build": "node scripts/prepare-dist.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-purchases": "tsx scripts/seedPurchases.ts",
    "db:ensure-lots": "tsx scripts/ensureStockLots.ts",
    "db:resync-mm": "tsx scripts/resyncMyanmarCatalog.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "concurrently": "^9.2.4",
    "typescript": "^5.7.3",
    "vite": "^8.3.1"
  }
}
